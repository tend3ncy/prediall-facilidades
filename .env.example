# Supabase (https://supabase.com → Settings → API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-anon-key-aqui

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua-chave-gemini-aqui

# Telegram Bot (criar via @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=seu-token-bot-aqui
TELEGRAM_CHAT_ID=id-do-grupo-ou-canal

# Configurações da aplicação
APP_NAME=PrediALL Facilidades
EMPRESA_NOME=Grupo Petrópolis
